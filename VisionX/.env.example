# CivicPulse AI - Environment Configuration

# ============================================
# DJANGO BACKEND
# ============================================
SECRET_KEY=your-super-secret-django-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=civicpulse_db
DB_USER=civicpulse_user
DB_PASSWORD=civicpulse_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# File Storage
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE=10485760  # 10MB

# ============================================
# FRONTEND
# ============================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=CivicPulse AI
VITE_APP_VERSION=1.0.0

# ============================================
# AI/ML CONFIGURATION
# ============================================
AI_MODEL_PATH=/app/ai_models
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
CLASSIFICATION_THRESHOLD=0.7
SPAM_SIMILARITY_THRESHOLD=0.85

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_TOKEN=your-whatsapp-token

# ============================================
# SECURITY
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
